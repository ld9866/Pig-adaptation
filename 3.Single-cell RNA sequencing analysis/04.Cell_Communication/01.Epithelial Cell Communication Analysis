# ============================================================
# CellChat Analysis: Pig-to-Human Ortholog Conversion + NOTCH Signaling
# Description: Converts pig scRNA-seq data to human orthologs via g:Orth,
#              runs CellChat for CP and TB groups, and analyzes NOTCH signaling.
# Prerequisite: seu_Epi (Seurat object of Epithelium cells) must exist
# ============================================================

# 0. Load packages
library(Seurat); library(Matrix); library(CellChat)
library(dplyr); library(data.table); library(ggplot2)
library(patchwork); library(future)

# ============================================================
# 1. Extract pig genes and check
# ============================================================
pig_genes <- rownames(seu_Epi)
length(pig_genes); head(pig_genes, 20)

# Remove NA/empty and duplicates, then save for g:Orth upload
pig_genes <- unique(pig_genes)
pig_genes <- pig_genes[!is.na(pig_genes) & pig_genes != ""]
length(pig_genes)

write.table(pig_genes, "pig_genes_for_gOrth.txt",
            quote = FALSE, row.names = FALSE, col.names = FALSE)

# ============================================================
# 2. Read g:Orth result (pig -> human orthologs)
# ============================================================
gorth <- fread("pig_human_gOrth.csv")
dim(gorth); head(gorth); colnames(gorth)

# ============================================================
# 3. Remove records without human ortholog
# ============================================================
gorth_use <- gorth[
  !is.na(ortholog_name) & ortholog_name != "" &
  !is.na(ortholog_ensg) & ortholog_ensg != ""
]
dim(gorth_use)

# ============================================================
# 4. Extract Seurat normalized expression
# ============================================================
DefaultAssay(seu_Epi) <- "RNA"
expr_pig <- GetAssayData(seu_Epi, assay = "RNA", layer = "data")
dim(expr_pig); head(rownames(expr_pig))

# Check if expression matrix uses symbol or Ensembl ID
head(rownames(expr_pig), 20)
mean(grepl("^ENSSSCG", rownames(expr_pig)))

# ============================================================
# 5. Build Pig symbol -> Human symbol mapping
# ============================================================
map <- gorth_use %>%
  as.data.frame() %>%
  transmute(
    pig_gene = initial_alias, pig_ensembl = initial_ensg,
    human_gene = ortholog_name, human_ensembl = ortholog_ensg
  ) %>%
  filter(pig_gene %in% rownames(expr_pig)) %>%
  distinct()

# ============================================================
# 6. Keep only 1-to-1 Pig -> Human relationships
# ============================================================
pig_n <- map %>% distinct(pig_gene, human_gene) %>% count(pig_gene, name = "n_human")
human_n <- map %>% distinct(pig_gene, human_gene) %>% count(human_gene, name = "n_pig")

map_1to1 <- map %>%
  left_join(pig_n, by = "pig_gene") %>%
  left_join(human_n, by = "human_gene") %>%
  filter(n_human == 1, n_pig == 1) %>%
  distinct(pig_gene, human_gene, .keep_all = TRUE)

dim(map_1to1); head(map_1to1)

# ============================================================
# 7. Check for duplicates (both should be 0)
# ============================================================
sum(duplicated(map_1to1$pig_gene))
sum(duplicated(map_1to1$human_gene))

# ============================================================
# 8. Save the 1-to-1 ortholog table
# ============================================================
write.csv(map_1to1, "Pig_Human_1to1_gOrth_for_CellChat.csv", row.names = FALSE)

# ============================================================
# 9. Build human expression matrix
# ============================================================
expr_human <- expr_pig[map_1to1$pig_gene, , drop = FALSE]
rownames(expr_human) <- map_1to1$human_gene

# ============================================================
# 10. Check mapping results
# ============================================================
dim(expr_pig); dim(expr_human)
sum(duplicated(rownames(expr_human)))

cat("Pig genes =", nrow(expr_pig), "\n")
cat("Mapped human genes =", nrow(expr_human), "\n")
cat("Mapping rate =", round(nrow(expr_human) / nrow(expr_pig) * 100, 2), "%\n")

# ============================================================
# 11. Check NOTCH pathway genes
# ============================================================
notch_genes <- c("NOTCH1", "NOTCH2", "NOTCH3", "NOTCH4",
                 "JAG1", "JAG2", "DLL1", "DLL3", "DLL4")
data.frame(gene = notch_genes, present = notch_genes %in% rownames(expr_human))

# ============================================================
# 12. Metadata alignment
# ============================================================
meta <- seu_Epi@meta.data
meta <- meta[colnames(expr_human), , drop = FALSE]
stopifnot(identical(rownames(meta), colnames(expr_human)))
table(meta$group); table(meta$celltype, meta$group)

# ============================================================
# 13. Split into CP and TB
# ============================================================
CP_cells <- rownames(meta)[meta$group == "CP"]
TB_cells <- rownames(meta)[meta$group == "TB"]

expr_CP <- expr_human[, CP_cells, drop = FALSE]
expr_TB <- expr_human[, TB_cells, drop = FALSE]
meta_CP <- meta[CP_cells, , drop = FALSE]
meta_TB <- meta[TB_cells, , drop = FALSE]

# ============================================================
# 14. CellChat database
# ============================================================
CellChatDB <- CellChatDB.human

# ============================================================
# 15. CP CellChat pipeline
# ============================================================
CP.cellchat <- createCellChat(object = expr_CP, meta = meta_CP, group.by = "celltype")
CP.cellchat@DB <- CellChatDB
CP.cellchat <- subsetData(CP.cellchat)
CP.cellchat <- identifyOverExpressedGenes(CP.cellchat)
CP.cellchat <- identifyOverExpressedInteractions(CP.cellchat)
CP.cellchat <- smoothData(CP.cellchat, adj = PPI.human)
CP.cellchat <- computeCommunProb(CP.cellchat, raw.use = TRUE)
CP.cellchat <- filterCommunication(CP.cellchat, min.cells = 10)
CP.cellchat <- computeCommunProbPathway(CP.cellchat)
CP.cellchat <- aggregateNet(CP.cellchat)

# ============================================================
# 16. TB CellChat pipeline
# ============================================================
TB.cellchat <- createCellChat(object = expr_TB, meta = meta_TB, group.by = "celltype")
TB.cellchat@DB <- CellChatDB
TB.cellchat <- subsetData(TB.cellchat)
TB.cellchat <- identifyOverExpressedGenes(TB.cellchat)
TB.cellchat <- identifyOverExpressedInteractions(TB.cellchat)
TB.cellchat <- smoothData(TB.cellchat, adj = PPI.human)
TB.cellchat <- computeCommunProb(TB.cellchat, raw.use = TRUE)
TB.cellchat <- filterCommunication(TB.cellchat, min.cells = 10)
TB.cellchat <- computeCommunProbPathway(TB.cellchat)
TB.cellchat <- aggregateNet(TB.cellchat)

# ============================================================
# 17. Save individual CellChat objects
# ============================================================
saveRDS(CP.cellchat, "CP_CellChat_gOrth.rds")
saveRDS(TB.cellchat, "TB_CellChat_gOrth.rds")

# ============================================================
# 18. Check NOTCH pathway presence
# ============================================================
"NOTCH" %in% CP.cellchat@netP$pathways
"NOTCH" %in% TB.cellchat@netP$pathways
CP.cellchat@netP$pathways
TB.cellchat@netP$pathways

# ============================================================
# 19. Merge CP and TB (1 = CP, 2 = TB)
# ============================================================
object.list <- list(CP = CP.cellchat, TB = TB.cellchat)
cellchat <- mergeCellChat(object.list, add.names = names(object.list))

# ============================================================
# 20. Compare total interactions / weights
# ============================================================
p1 <- compareInteractions(cellchat, show.legend = FALSE, group = c(1, 2))
p2 <- compareInteractions(cellchat, show.legend = FALSE, group = c(1, 2), measure = "weight")
p1 + p2

# ============================================================
# 21. Differential interaction network
# ============================================================
par(mfrow = c(1, 2), xpd = TRUE)
netVisual_diffInteraction(cellchat, weight.scale = TRUE)
netVisual_diffInteraction(cellchat, weight.scale = TRUE, measure = "weight")

# ============================================================
# 22. NOTCH signaling increased in TB
# ============================================================
p7 <- netVisual_bubble(cellchat, comparison = c(1, 2), max.dataset = 2,
                       signaling = "NOTCH",
                       title.name = "Increased NOTCH signaling in TB",
                       angle.x = 45, remove.isolate = TRUE)
p7

# ============================================================
# 23. NOTCH signaling decreased in TB
# ============================================================
p8 <- netVisual_bubble(cellchat, comparison = c(1, 2), max.dataset = 1,
                       signaling = "NOTCH",
                       title.name = "Decreased NOTCH signaling in TB",
                       angle.x = 45, remove.isolate = TRUE)
p8
p7 + p8

# ============================================================
# 24. NOTCH network visualization
# ============================================================
netVisual_aggregate(CP.cellchat, signaling = "NOTCH", layout = "circle")
netVisual_aggregate(TB.cellchat, signaling = "NOTCH", layout = "circle")

# ============================================================
# 25. Extract NOTCH communication results
# ============================================================
CP.NOTCH <- subsetCommunication(CP.cellchat, signaling = "NOTCH")
TB.NOTCH <- subsetCommunication(TB.cellchat, signaling = "NOTCH")
CP.NOTCH; TB.NOTCH

# Optional: ranked network comparison and gene expression plot
# gg1 <- rankNet(cellchat, mode = "comparison", stacked = TRUE,
#                do.stat = TRUE, comparison = c(1, 2))
gg2 <- rankNet(cellchat, mode = "comparison", stacked = FALSE,
               do.stat = TRUE, comparison = c(1, 2))

cellchat@meta$datasets <- factor(cellchat@meta$datasets, levels = c("CP", "TB"))
plotGeneExpression(cellchat, signaling = "NOTCH", split.by = "datasets", colors.ggplot = TRUE)

# ============================================================
# 26. Save NOTCH results
# ============================================================
write.csv(CP.NOTCH, "CP_NOTCH_CellChat.csv", row.names = FALSE)
write.csv(TB.NOTCH, "TB_NOTCH_CellChat.csv", row.names = FALSE)

# ============================================================
# 27. Save merged CellChat object
# ============================================================
saveRDS(cellchat, "CP_TB_CellChat_gOrth_merged.rds")
